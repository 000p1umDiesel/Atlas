node {
  diameter: 40px;
  color: #A5ABB6;
  border-color: #9AA1AC;
  text-color-internal: #FFFFFF;
  font-size: 10px;
  caption: "<id>";
}

node.Entity {
  diameter: 55px;
  color: #4C8EDA;
  border-color: #2870C2;
  text-color-internal: #FFFFFF;
  caption: "{name}";
}

node.Document {
  diameter: 70px;
  color: #F79767;
  border-color: #F36924;
  text-color-internal: #FFFFFF;
  caption: "{title}";
}

node.Chunk {
  diameter: 30px;
  color: #C990C0;
  border-color: #B261A5;
  text-color-internal: #FFFFFF;
  caption: "{idx}";
}

node.WikiPage {
  diameter: 45px;
  color: #57C7E3;
  border-color: #23B3D7;
  text-color-internal: #2A2C34;
  caption: "{title}";
}

node.Person { color: #F16667; border-color: #EB2728; }
node.Organization { color: #D9C8AE; border-color: #C0A378; text-color-internal: #2A2C34; }
node.Concept { color: #4C8EDA; border-color: #2870C2; }
node.Method { color: #8DCC93; border-color: #5DB665; text-color-internal: #2A2C34; }
node.Technology { color: #FFC454; border-color: #D7A013; text-color-internal: #2A2C34; }
node.Dataset { color: #DA7194; border-color: #CC3C6C; }
node.Work { color: #569480; border-color: #447666; }
node.Event { color: #ECB5C9; border-color: #DA7298; text-color-internal: #2A2C34; }
node.Location { color: #6DCE9E; border-color: #60B58B; text-color-internal: #2A2C34; }
node.Project { color: #AF7AC5; border-color: #884EA0; }
node.Product { color: #C2185B; border-color: #880E4F; }
node.Software { color: #68BDF6; border-color: #5CA8DB; text-color-internal: #2A2C34; }
node.AIModel { color: #17A589; border-color: #117864; }
node.Field { color: #A3E4D7; border-color: #48C9B0; text-color-internal: #2A2C34; }
node.Metric { color: #E8DAEF; border-color: #BB8FCE; text-color-internal: #2A2C34; }
node.Regulation { color: #5D6D7E; border-color: #34495E; }
node.Substance { color: #827717; border-color: #524C0F; }
node.Condition { color: #C0392B; border-color: #922B21; }
node.Organism { color: #8D6E63; border-color: #5D4037; }
node.Other { color: #A5ABB6; border-color: #9AA1AC; }

relationship {
  color: #A5ABB6;
  shaft-width: 1px;
  font-size: 8px;
  padding: 3px;
  text-color-external: #000000;
  text-color-internal: #FFFFFF;
  caption: "<type>";
}

relationship.RELATED {
  color: #4C8EDA;
  shaft-width: 2px;
  caption: "{predicate}";
}
