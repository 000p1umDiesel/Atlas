# Скопируйте в .env; настоящие ключи не добавляйте в Git.
# У каждой локальной модели свой порт; поменять его можно в соответствующем BASE_URL.
# Ячейка печати команд формирует команды llama-server по этим адресам.
# Замените LLM_* настройками своего провайдера; подробнее в SETUP.md.
LLM_BASE_URL=https://codex.sale/v1
LLM_MODEL=gpt-6-luna
LLM_API_KEY=
EMBED_BASE_URL=http://localhost:8101/v1
EMBED_MODEL=mradermacher/Qwen3-Embedding-0.6B-GGUF:Q8_0
EMBED_API_KEY=
RERANK_BASE_URL=http://localhost:8102/v1
RERANK_MODEL=gorse-io/Qwen3-Reranker-0.6B-GGUF:Q8_0
RERANK_API_KEY=
VISION_BASE_URL=http://localhost:8103/v1
VISION_MODEL=prithivMLmods/Xiaomi-OCR-0-GGUF:Q6_K
VISION_API_KEY=
QDRANT_URL=http://localhost:6333
# Пустые значения ниже наследуют настройки генератора или embeddings.
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=
# Embeddings для Answer Relevancy: сравнивают исходный вопрос с вопросами, составленными по ответу.
# Можно оставить пустыми: будут использованы EMBED_BASE_URL, EMBED_MODEL и EMBED_API_KEY.
JUDGE_EMBED_BASE_URL=
JUDGE_EMBED_MODEL=
JUDGE_EMBED_API_KEY=
# Отключает статистику использования Ragas; не отключает API-запросы для оценки.
RAGAS_DO_NOT_TRACK=true
