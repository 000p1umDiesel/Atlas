# Скопируйте в .env и заполните LLM_*. Настоящие ключи в Git не кладите.

# LLM для ответов (02) и, по умолчанию, для оценки (03). Подойдёт любой OpenAI-совместимый API.
# Результаты в ноутбуках получены с этой моделью.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Локальные llama-server, команды запуска в SETUP.md. Ключи не нужны.
EMBED_BASE_URL=http://localhost:8101/v1
EMBED_MODEL=mradermacher/Qwen3-Embedding-0.6B-GGUF:Q8_0
EMBED_API_KEY=
RERANK_BASE_URL=http://localhost:8102/v1
RERANK_MODEL=gorse-io/Qwen3-Reranker-0.6B-GGUF:Q8_0
RERANK_API_KEY=
VISION_BASE_URL=http://localhost:8103/v1
VISION_MODEL=prithivMLmods/Xiaomi-OCR-0-GGUF:Q6_K
VISION_API_KEY=

QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333

# Отдельный судья для Ragas. Пустые значения: судья = LLM_*, embeddings = EMBED_*.
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=
JUDGE_EMBED_BASE_URL=
JUDGE_EMBED_MODEL=
JUDGE_EMBED_API_KEY=
