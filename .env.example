# Copy to .env (never commit .env)
LLM_API_KEY=
NEO4J_PASSWORD=mnogobase-dev

# Независимый судья для eval score (необязательно; по умолчанию llm / embedder).
# MNOGOBASE_EVALUATION__BASE_URL=https://judge.example/v1
# MNOGOBASE_EVALUATION__MODEL=judge-model
# MNOGOBASE_EVALUATION__API_KEY_ENV=JUDGE_API_KEY
# JUDGE_API_KEY=
# MNOGOBASE_EVALUATION__EMBEDDING_URL=http://localhost:8001/v1
# MNOGOBASE_EVALUATION__EMBEDDING_MODEL=embedding-model
# MNOGOBASE_EVALUATION__EMBEDDING_API_KEY_ENV=JUDGE_EMBED_API_KEY
# JUDGE_EMBED_API_KEY=

# --- сервер (README, раздел 11) ---
# HF_TOKEN=                                   # только для закрытых моделей на Hugging Face
# MNOGOBASE_DEVICE=auto                       # config.yaml настроен на mps (Mac)
# COMPOSE_FILE=docker-compose.yml:docker-compose.cuda.yml
# MODELS_BIND=0.0.0.0                         # открыть порты моделей наружу (по умолчанию 127.0.0.1)
# роль на другом бэкенде, чем в config.yaml (раздел 7.15), например LLM на vLLM:
# MNOGOBASE_LLM__SERVE=vllm
# MNOGOBASE_LLM__MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507-FP8
# MNOGOBASE_LLM__BASE_URL=
