# Только секреты. Скопируйте в .env (никогда не коммитьте .env); пароли: openssl rand -hex 24
# Адреса, порты и остальные настройки — в config.yaml.
# Ключ внешнего LLM (llm.api_key_env в config.yaml); пустой — для локального сервера без ключа.
LLM_API_KEY=
# Пароли баз задаются при первом старте контейнеров; на сервере замените их до первого запуска.
POSTGRES_PASSWORD=mnogobase-dev
NEO4J_PASSWORD=mnogobase-dev
QDRANT_API_KEY=change-me          # ключ Qdrant из compose.yaml (сайт localhost:6333/dashboard)

# Необязательно
# MB_LOG_DRIVER=journald         # только на сервере: логи контейнеров в журнал хоста (на Mac — local)
# HF_TOKEN=                       # только для закрытых моделей на Hugging Face
# JUDGE_API_KEY=                  # судья eval score, если evaluation.api_key_env: JUDGE_API_KEY
