#!/usr/bin/env bash
set -euo pipefail
cd /srv/mnogobase/app
mountpoint -q /srv/mnogobase || exit 1
set -a
source /srv/mnogobase/config/storage.env
if test -r /srv/mnogobase/config/api.env; then
    source /srv/mnogobase/config/api.env
fi
set +a
export MODELS_BIND=127.0.0.1
export HF_HOME=/srv/mnogobase/cache/runtime/huggingface
export DOCLING_CACHE_DIR=/srv/mnogobase/cache/runtime/docling
export FASTEMBED_CACHE_PATH=/srv/mnogobase/cache/runtime/fastembed
export XDG_CACHE_HOME=/srv/mnogobase/cache/runtime
export TMPDIR=/srv/mnogobase/data/tmp
if [ "$(id -u)" = 0 ]; then
    export MNOGOBASE_LOGS_DIR=/srv/mnogobase/data/operator-logs
fi
export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2
export TOKENIZERS_PARALLELISM=false
exec .venv/bin/mnogobase -c /srv/mnogobase/config/config.yaml "$@"
