[Unit]
Description=Mnogobase team API
Requires=mnogobase-storage.service mnogobase-models.service
After=mnogobase-storage.service mnogobase-models.service mnogobase-worker.service mnogobase-monitor.service
RequiresMountsFor=/srv/mnogobase
PartOf=mnogobase.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=exec
User=mnogobase
Group=mnogobase
Slice=mnogobase-app.slice
WorkingDirectory=/srv/mnogobase/app
Environment=PYTHONUNBUFFERED=1 HOME=/srv/mnogobase/cache/runtime
ExecStart=/bin/bash /srv/mnogobase/app/deploy/shared-host/run api serve --host 127.0.0.1 --port 8080
ExecStartPost=/usr/bin/timeout 60 /bin/bash -c 'until /usr/bin/curl --fail --silent --max-time 2 --output /dev/null http://127.0.0.1:8080/health; do sleep 1; done'
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=15min
KillMode=mixed
OOMPolicy=stop
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/mnogobase/data /srv/mnogobase/cache/runtime /srv/mnogobase/app/.venv
