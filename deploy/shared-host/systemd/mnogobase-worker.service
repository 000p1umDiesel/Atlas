[Unit]
Description=Mnogobase team job worker
Requires=mnogobase-storage.service mnogobase-models.service
After=mnogobase-storage.service mnogobase-models.service
RequiresMountsFor=/srv/mnogobase
PartOf=mnogobase.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=exec
User=mnogobase
Group=mnogobase
Slice=mnogobase-app.slice
WorkingDirectory=/srv/mnogobase/app
Environment=PYTHONUNBUFFERED=1 HOME=/srv/mnogobase/cache/runtime
ExecStart=/bin/bash /srv/mnogobase/app/deploy/shared-host/run service work
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=15min
OOMPolicy=stop
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/mnogobase/data /srv/mnogobase/cache/runtime /srv/mnogobase/app/.venv
