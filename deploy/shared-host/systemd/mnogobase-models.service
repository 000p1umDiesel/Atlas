[Unit]
Description=Mnogobase native CPU model lifecycle with Vision
Requires=docker.service mnogobase-storage.service
After=docker.service mnogobase-storage.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/mnogobase
PartOf=mnogobase.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/mnogobase/app
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash /srv/mnogobase/app/deploy/shared-host/run models up
ExecStopPost=/bin/bash /srv/mnogobase/app/deploy/shared-host/run models down
TimeoutStartSec=30min
TimeoutStopSec=2min
UMask=0077
