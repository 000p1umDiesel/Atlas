# fail2ban: блокировка подбора пароля к mnogobase. Установка: /etc/fail2ban/jail.d/mnogobase-login.local
# 3 неудачных входа с одного IP за 7 дней — вечный бан, только порты 80/443 (SSH не трогает).
# Вечные баны fail2ban хранит в своей базе, они переживают перезагрузку.
# Себя разбанить по SSH: sudo fail2ban-client set mnogobase-login unbanip IP
[mnogobase-login]
enabled = true
filter = mnogobase-login
port = http,https
logpath = /var/log/nginx/mnogobase.access.log
backend = auto
maxretry = 3
findtime = 7d
bantime = -1
